#!/bin/sh
# agent-lock launcher: exec this machine's native binary from bin/native (fail open).
case $0 in */*) d=${0%/*}/native ;; *) d=native ;; esac
if [ -d /System/Library ]; then
  # bash sets HOSTTYPE (no process); other shells leave it unset: ask uname then.
  m=${HOSTTYPE:-$(/usr/bin/uname -m 2>/dev/null)}; [ "$m" = aarch64 ] && m=arm64
  for f in "$d/agent-lock-darwin" "$d/agent-lock-darwin-$m"; do
    [ -x "$f" ] && exec "$f" "$@"
  done
else
  m=$(uname -m); [ "$m" = aarch64 ] && m=arm64
  [ -x "$d/agent-lock-linux-$m" ] && exec "$d/agent-lock-linux-$m" "$@"
fi
echo "agent-lock: no native binary for this machine in $d (agent-lock is inactive)" >&2
exit 0
